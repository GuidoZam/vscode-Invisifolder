{
  "name": "invisifolder",
  "displayName": "Invisifolder",
  "description": "Hide selected folders in VS Code for a cleaner workspace.",
  "version": "0.1.0",
  "publisher": "your-publisher",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Other"],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:invisifolder.addFolder",
    "onCommand:invisifolder.removeFolder",
    "onCommand:invisifolder.toggleFolder",
    "onCommand:invisifolder.manage"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "invisifolder.addFolder", "title": "Invisifolder: Hide Folder" },
      { "command": "invisifolder.removeFolder", "title": "Invisifolder: Unhide Folder" },
      { "command": "invisifolder.toggleFolder", "title": "Invisifolder: Toggle Folder Visibility" },
      { "command": "invisifolder.manage", "title": "Invisifolder: Manage Hidden Folders" }
    ],
    "menus": {
      "explorer/context": [
        { "command": "invisifolder.addFolder", "when": "resourceScheme == 'file'", "group": "navigation" },
        { "command": "invisifolder.toggleFolder", "when": "resourceScheme == 'file'", "group": "navigation" }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "pretest": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^4.9.5",
    "@vscode/test-electron": "^2.3.0"
  }
}
